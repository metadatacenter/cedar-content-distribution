{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "cedar-content-distribution": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src/..",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/cedar-content-distribution-src",
            "index": "index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "cedar-embeddable-editor-sample-templates",
                "output": "cedar-embeddable-editor-sample-templates"
              }
            ]
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": false
            },
            "production": {
              "optimization": true,
              "sourceMap": false
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "cedar-content-distribution:build:development",
              "port": 4240,
              "host": "0.0.0.0",
              "allowedHosts": true
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "62ce21c3-5463-47c1-af34-477392e7cdd5"
  }
}
